<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UMVC3.ModManager.ViewModels"
        x:Class="UMVC3.ModManager.Views.MainWindow"
        Title="UMvC3 Mod Loader"
        Width="980" Height="640"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Game / library paths -->
        <Grid Grid.Row="0" Margin="12,12,12,6" ColumnDefinitions="Auto,*,Auto,14,Auto,*,Auto">
            <TextBlock Text="Game folder" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" Text="{Binding GameDir}" IsReadOnly="True"/>
            <Button Grid.Column="2" Content="Browse…" Command="{Binding PickGameFolderCommand}" Margin="6,0,0,0"/>
            <TextBlock Grid.Column="4" Text="Mod library" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="5" Text="{Binding ModLibraryDir}" IsReadOnly="True"/>
            <Button Grid.Column="6" Content="Browse…" Command="{Binding PickLibraryFolderCommand}" Margin="6,0,0,0"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding GameFound}" Margin="12,2,12,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

        <!-- Mod list -->
        <DockPanel Grid.Row="2" Margin="12,10,12,6">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                <TextBlock Text="Installed mods" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding EnabledCount, StringFormat='{}{0} enabled'}"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Button Grid.Column="2" Content="+ Add mod folder" Command="{Binding AddModFolderCommand}"/>
            </Grid>

            <ListBox ItemsSource="{Binding Mods}" BorderThickness="1"
                     BorderBrush="{DynamicResource BorderLowBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="34,Auto,*,Auto,150,34,Auto" Margin="2">
                            <TextBlock Text="{Binding PriorityLabel}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      IsCheckedChanged="OnModToggled"
                                      VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding KindDescription}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SizeLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding HookBadge}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
                                <Button Content="▲" ToolTip.Tip="Increase priority"
                                        IsEnabled="{Binding IsEnabled}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveUpCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="▼" ToolTip.Tip="Decrease priority"
                                        IsEnabled="{Binding IsEnabled}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveDownCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="✕" ToolTip.Tip="Remove from list"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveModCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Loader hint -->
        <TextBlock Grid.Row="3" Text="{Binding LoaderHint}" Margin="12,0,12,6" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <!-- Actions -->
        <Grid Grid.Row="4" Margin="12,6,12,12" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Button Content="Deploy loader" Command="{Binding DeployLoaderCommand}" Padding="14,6"/>
            <Button Grid.Column="1" Content="Remove loader" Command="{Binding UndeployLoaderCommand}" Margin="8,0,0,0" Padding="14,6"/>
            <Button Grid.Column="2" Content="Apply" Command="{Binding ApplyConfigCommand}" Margin="8,0,0,0" Padding="14,6"/>
            <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" Padding="14,6"/>
            <Button Grid.Column="5" Content="Launch game" Command="{Binding LaunchGameCommand}" Padding="18,8"
                    Classes="accent"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="5" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderLowBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <TextBlock Text="{Binding Status}" Margin="12,6" TextWrapping="Wrap"/>
        </Border>

    </Grid>
</Window>
